---
import { Font } from "astro:assets";

import "@/styles/global.css";
import "@/styles/theme.css";

import Header from "@/layouts/Header.astro";
import Footer from "@/layouts/Footer.astro";
import { siteConfig } from "@/data/contentCollectionDataFetching";

interface Props {
  pageTitle: string;
}

const { pageTitle } = Astro.props;

const siteName = siteConfig?.data.general.name ?? "Church Website";
const colorScheme = siteConfig?.data.theme?.colorScheme ?? "auto";
const metaTitle = pageTitle ? `${pageTitle} | ${siteName}` : siteName;
const metaDescription =
  siteConfig?.data.general.description ?? "Church website built with Astro.";
---

<script is:inline define:vars={{ colorScheme }}>
  const getThemePreference = () => {
    return window.matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light";
  };

  const isDark =
    colorScheme === "dark" ||
    (colorScheme === "auto" && getThemePreference() === "dark");

  document.documentElement.classList[isDark ? "add" : "remove"]("dark");
</script>

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={metaDescription} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="icon" type="image/svg+xml" href={"/hero-bg.jpg"} />

    <title>{metaTitle}</title>

    <Font cssVariable="--font-poppins" preload />

    <style>
      html,
      body {
        margin: 0;
        min-height: 100%;
      }

      body {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      main {
        flex: 1;
        min-height: 0;
      }

      .hero {
        height: 100%;
        min-height: 0;
      }
    </style>
  </head>

  <body>
    <Header />

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>